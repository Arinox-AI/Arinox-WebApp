# GCP MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.gcp.mongodb.net/arinox?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=development

# Client
VITE_API_URL=http://localhost:5000/api/v1

# Email (for contact form)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_app_password
EMAIL_TO=contact@arinox.ai
