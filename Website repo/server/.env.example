# ─────────────────────────────────────────────
# Supabase — get all values from your Supabase project dashboard
# Dashboard → Project Settings → Database & API
# ─────────────────────────────────────────────

# PostgreSQL connection string (Dashboard → Project Settings → Database → URI)
# Use the "Transaction pooler" URI (port 6543) for serverless/edge, or
# "Session pooler" URI (port 5432) for persistent Node.js servers.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase API (Dashboard → Project Settings → API)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# JWT (custom auth layer on top of Supabase Postgres)
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# URLs
CLIENT_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Groq AI (chatbot — https://console.groq.com)
# ─────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─────────────────────────────────────────────
# Email (contact form — use a Gmail App Password)
# ─────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_app_password
EMAIL_TO=assist@arinox.ai
