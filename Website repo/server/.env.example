# MySQL — GCP Cloud SQL for MySQL (update host/user/pass for production)
DB_HOST=<cloud-sql-public-ip-or-localhost>
DB_PORT=3306
DB_NAME=arinox
DB_USER=<db-user>
DB_PASS=<db-password>

PORT=5000
NODE_ENV=development

