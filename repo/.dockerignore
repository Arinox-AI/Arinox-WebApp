# Dependencies — reinstalled inside Docker
**/node_modules

# Environment files — never bake secrets into image
.env
**/.env
server/.env
client/.env
**/.env.local
**/.env.*.local

# Build output — rebuilt inside Docker
client/dist
**/.vite

# Git
.git
.gitignore
.gitattributes

# Logs
**/*.log
**/npm-debug.log*

# OS files
**/.DS_Store
**/Thumbs.db

# Editor
**/.vscode
**/.idea

# Deploy scripts (not needed inside container)
.dockerignore
deploy.ps1
deploy-staging.ps1
