# Root node_modules (only has concurrently — not needed on App Engine)
/node_modules/

# Client source — only the built dist/ is needed
/client/node_modules/
/client/src/
/client/public/
/client/index.html
/client/vite.config.js
/client/tailwind.config.js
/client/postcss.config.js

# Secrets — never upload .env files
.env
server/.env
client/.env
**/.env.local
**/.env.example

# Git
.git
.gitignore
.gitattributes
.gitmodules

# Logs & OS files
**/*.log
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Deploy scripts (not needed in runtime)
deploy.ps1
deploy-staging.ps1
